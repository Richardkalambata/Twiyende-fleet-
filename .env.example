# Pooled Postgres URL (Neon pooler on Vercel). Required.
DATABASE_URL=

# Direct Postgres URL for local demo data. Optional; falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# For remote PostgreSQL schema changes, use a separate role and sslmode=verify-full.
TWENDE_MIGRATION_DATABASE_URL=

# Production blocks demo sessions and money movement until a live adapter is ready.
TWENDE_ENV=demo
TWENDE_MANAGED_DATABASE=0

# One-tap demo chips were removed from the product UI.
# DEMO_ROLE_SWITCHER is unused by the screens. Enable one-tap demo sign-in only on an isolated demo database.
DEMO_ROLE_SWITCHER=0

# "simulated" tops up and pays out without moving real money.
# A real aggregator implements PaymentProvider in lib/payments/.
PAYMENT_PROVIDER=simulated

# Optional. Lost-item photos are stored in Postgres (bytea/text) with a size limit.
# BLOB_READ_WRITE_TOKEN is not required.
# Sessions use a random httpOnly cookie. SESSION_SECRET is not required.

# Operator SMS verification. Use a six-digit Verify service and enable Zambia SMS.
OPERATOR_SMS_REQUIRED=0
TWILIO_VERIFY_SERVICE_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
