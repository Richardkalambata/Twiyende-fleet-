# Pooled Postgres URL (Neon pooler on Vercel). Required.
DATABASE_URL=

# Direct Postgres URL for seeding and DDL. Optional; falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# One-tap demo chips were removed from the product UI.
# DEMO_ROLE_SWITCHER is unused by the screens. Seed accounts still use PIN 1234.
DEMO_ROLE_SWITCHER=0

# "simulated" tops up and pays out without moving real money.
# A real aggregator implements PaymentProvider in lib/payments/.
PAYMENT_PROVIDER=simulated

# Optional. Lost-item photos are stored in Postgres (bytea/text) with a size limit.
# BLOB_READ_WRITE_TOKEN is not required.
# Sessions use a random httpOnly cookie. SESSION_SECRET is not required.
