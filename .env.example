# Optional. Defaults to data/twende.sqlite — no account or secret required.
DATABASE_PATH=

# Set to 0 before a real deployment to turn off one-tap demo sign-in.
DEMO_ROLE_SWITCHER=1

# "simulated" tops up and pays out without moving real money.
# Swap in an aggregator by implementing PaymentProvider in lib/payments/.
PAYMENT_PROVIDER=simulated
